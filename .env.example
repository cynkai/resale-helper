# 모든 값은 선택 사항입니다. 비워 두어도 수동 입력으로 핵심 흐름을 끝까지 사용할 수 있습니다.
# 이 파일을 .env.local 로 복사해 사용하세요. .env.local 은 Git에 올라가지 않습니다.

# SQLite DB 파일 경로 (기본값: ./data/resale.db)
DATABASE_PATH=./data/resale.db

# 국립중앙도서관 ISBN 서지정보 API 인증키 (서지정보 자동 채움용, 가격 정보 아님)
# 발급: https://www.nl.go.kr/NL/contents/N31101020000.do (회원가입 → 신청 → 담당자 승인)
# 서버에서만 읽으며 브라우저로 전달되지 않습니다.
NLK_CERT_KEY=

# 1 로 설정하면 모든 외부 조회(서지정보)를 끕니다.
RESALE_DISABLE_EXTERNAL=
