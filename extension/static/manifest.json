{
  "manifest_version": 3,
  "name": "얼마에 팔까 — 직접 담기",
  "description": "지금 보고 있는 중고 매물 한 건을, 버튼을 눌렀을 때만 내 컴퓨터의 '얼마에 팔까' 앱에 가격 자료로 저장합니다.",
  "version": "0.1.0",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:3000/*"],
  "action": { "default_title": "직접 담기", "default_popup": "popup.html" }
}
